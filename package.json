{
  "name": "pirut",
  "version": "0.0.0",
  "private": true,
  "description": "Personal-first web application for manually importing and analyzing Israeli credit card statements",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "format": "prettier --write . \"!pnpm-lock.yaml\" \"!db/migrations/**\" \"!docs/CHANGELOG.md\"",
    "format:check": "prettier --check . \"!pnpm-lock.yaml\" \"!db/migrations/**\" \"!docs/CHANGELOG.md\"",
    "lint": "eslint --config config/eslint.config.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build:server": "tsc -p config/typescript/tsconfig.server.json",
    "dev:server": "node --watch src/server/index.ts",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate": "node src/infrastructure/db/migrate.ts"
  },
  "prettier": {
    "printWidth": 100
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "i18next": "^26.7.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  }
}
