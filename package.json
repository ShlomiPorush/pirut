{
  "name": "pirut",
  "version": "0.0.0",
  "private": true,
  "description": "Personal-first web application for manually importing and analyzing Israeli credit card statements",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build:server": "tsc -p config/typescript/tsconfig.server.json",
    "dev:server": "node --watch src/server/index.ts",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate": "node src/infrastructure/db/migrate.ts"
  },
  "prettier": {
    "printWidth": 100
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "i18next": "^26.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
