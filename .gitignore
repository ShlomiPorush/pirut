# Local runtime configuration
.env
.env.*
!.env.example

# Machine-local Docker development definition
docker-compose-dev.yml

# Sensitive and durable local data
data/
backups/
tmp/

# Editor and operating system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Test and build output
coverage/
dist/
build/
*.tsbuildinfo

# Real financial data. Statement exports must never enter this public repository.
# `internal/` is the working directory for unsanitized issuer files.
internal/
*.xlsx
*.xls
*.csv
*.pdf
# Sanitized fixtures are the one exception and are added deliberately.
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.xls
!tests/fixtures/**/*.csv
