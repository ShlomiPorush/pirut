# Copy to .env and adjust. The .env file is machine-local and never committed.

# Application image tag resolved by Compose.
PIRUT_IMAGE=ghcr.io/shlomiporush/pirut:0.0.0

# Durable host directory that holds PostgreSQL data and backups.
# It must be a Linux-native path on the Docker host. A Windows-drive path under
# /mnt/ cannot hold a PostgreSQL cluster: the DrvFs mount rejects the ownership
# and permission changes that initdb requires.
PIRUT_DATA_DIR=/var/lib/pirut

# Host port for the web service. It is always bound to 127.0.0.1.
PIRUT_WEB_PORT=4610

# PostgreSQL credentials used by both the db service and the application.
POSTGRES_DB=pirut
POSTGRES_USER=pirut
POSTGRES_PASSWORD=replace-with-a-local-password

# Connection string consumed by the application. Host must match the Compose service name.
PIRUT_DATABASE_URL=postgres://pirut:replace-with-a-local-password@db:5432/pirut

# Application log level: fatal, error, warn, info, debug, trace, silent.
# Extra origins Pirut accepts besides PIRUT_PUBLIC_URL, comma separated. Add the address
# your reverse proxy serves, otherwise sign-in fails with an unrecognised-origin message.
# PIRUT_TRUSTED_ORIGINS=https://pirut.example.com

PIRUT_LOG_LEVEL=info

# The absolute URL the household reaches Pirut on, as typed into a browser. It decides the
# session cookie scheme and the passkey relying party. WebAuthn refuses an IP address, so
# this must name a host, never 127.0.0.1.
PIRUT_PUBLIC_URL=http://localhost:4610

# Signing key for sessions and tokens. At least 32 characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs every member out.
PIRUT_AUTH_SECRET=replace-with-at-least-32-random-characters--------
