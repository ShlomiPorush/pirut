# Template used by `scripts/local.sh init` to create the machine-local root .env file.
# Values here are safe development placeholders only.

PIRUT_IMAGE=pirut-web:dev

# Durable PostgreSQL data and backups. This must be a Linux-native path.
# A Windows-drive path under /mnt/ cannot hold a PostgreSQL cluster, because the
# DrvFs mount rejects the ownership and permission changes that initdb requires.
# `scripts/local.sh init` fills this in with the current WSL user's data directory.
PIRUT_DATA_DIR=__PIRUT_DATA_DIR__

PIRUT_WEB_PORT=4610

POSTGRES_DB=pirut
POSTGRES_USER=pirut
POSTGRES_PASSWORD=pirut-local-development

PIRUT_DATABASE_URL=postgres://pirut:pirut-local-development@db:5432/pirut

# Extra origins Pirut accepts besides PIRUT_PUBLIC_URL, comma separated.
# PIRUT_TRUSTED_ORIGINS=https://pirut.example.com

PIRUT_LOG_LEVEL=info

PIRUT_PUBLIC_URL=http://localhost:4610

# Development placeholder only. Generate a real one with: openssl rand -base64 48
PIRUT_AUTH_SECRET=replace-with-at-least-32-random-characters--------
